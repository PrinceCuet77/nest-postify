model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password      String?
  role          Role       @default(USER)
  status        UserStatus @default(NOT_VERIFIED)
  name          String?
  bio           String?
  profession    String?
  avatarKey     String?
  isPremiumUser Boolean    @default(false)
  auths         Auth[]

  posts    Post[]
  comments Comment[]
  replies  Reply[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
