model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  password           String?
  role               Role       @default(USER)
  status             UserStatus @default(NOT_VERIFIED)
  name               String?
  bio                String?
  profession         String?
  avatarUrlForGoogle String?
  avatarKey          String?
  isPremiumUser      Boolean    @default(false)
  hashedRefreshToken String?
  activeProvider     AuthProvider?
  auths              Auth[]

  posts    Post[]
  comments Comment[]
  replies  Reply[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
